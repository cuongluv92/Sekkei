# oku-pro — Supabase connection
#
# This app has no login/Auth of any kind — the browser talks to Supabase
# directly using the public anon key below. Copy this file to `.env.local`
# (gitignored) for local development, and set the same two variables in
# Vercel → Project Settings → Environment Variables for Production/Preview/
# Development, then redeploy. Never commit real values — this file only
# documents the variable names.
#
# Both values come from the Supabase dashboard: Project Settings → API.
# NEXT_PUBLIC_* variables are bundled into client JS and are meant to be
# public; the anon key is safe to expose by design as long as Row Level
# Security policies (see supabase/migrations/0001_init.sql) are in place.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
